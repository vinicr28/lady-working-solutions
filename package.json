{
  "name": "lady-working-solutions",
  "version": "1.0.0",
  "description": "Lady Working Solutions — Conectando maes talentosas ao mercado B2B",
  "type": "module",
  "scripts": {
    "build": "vite build && cp -r public/assets dist/client/",
    "server": "tsx src/server/index.ts",
    "dev": "concurrently \"vite build --watch\" \"nodemon --exec tsx src/server/index.ts\"",
    "start": "node --import tsx src/server/index.ts"
  },
  "dependencies": {
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.2",
    "tsx": "^4.7.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.5",
    "concurrently": "^8.2.2",
    "nodemon": "^3.0.3",
    "typescript": "^5.3.3",
    "vite": "^5.0.12"
  }
}
