{
  "name": "lady-working-solutions",
  "version": "1.0.0",
  "description": "Lady Working Solutions — Conectando maes talentosas ao mercado B2B",
  "type": "module",
  "scripts": {
    "build": "vite build && cp -r public/assets dist/client/",
    "server": "tsx src/server/index.ts",
    "dev": "concurrently \"vite build --watch\" \"nodemon --exec tsx src/server/index.ts\"",
    "start": "node --import tsx src/server/index.ts"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.2",
    "framer-motion": "^12.40.0",
    "lucide-react": "^1.17.0",
    "motion": "^12.40.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^3.6.0",
    "tsx": "^4.7.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.5",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.5.0",
    "concurrently": "^8.2.2",
    "nodemon": "^3.0.3",
    "postcss": "^8.5.15",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.3.3",
    "vite": "^5.0.12"
  }
